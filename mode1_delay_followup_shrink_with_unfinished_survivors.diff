+    def _should_delay_mode1_followup_shrink_for_survivors(
+            self, target_active_ranks: tuple[int, ...],
+            natural_active_ranks: list[int], dp_world_size: int) -> bool:
+        """Avoid rebuilding mode=1 groups while survivor ranks are decoding.
+
+        Mode=1 rebuild moves resident expert slots and MC2/EP/DP groups in the
+        same control path used by decode.  The initial full-world shrink is
+        tolerated, but follow-up shrinks from an already-shrunk group can leave
+        exiting ranks and survivor ranks on different communication lifetimes if
+        the survivors still have local unfinished requests.  Keep the old group
+        alive and let exiting ranks run dummy batches until the tail is idle.
+        """
+        if int(getattr(envs_ascend, "VLLM_ASCEND_ELASTIC_EXECUTION_MODE", 0)) != 1:
+            return False
+        if os.getenv(
+                "VLLM_ASCEND_MODE1_DELAY_FOLLOWUP_SHRINK_WITH_UNFINISHED_SURVIVORS",
+                "1").lower() in ("0", "false", "no", "off"):
+            return False
+        current_active = self.elastic_ep_active_ranks
+        if current_active is None:
+            return False
+        if not target_active_ranks:
+            return False
+        current_set = set(current_active)
+        target_set = set(target_active_ranks)
+        if not target_set.issubset(current_set):
+            return False
+        if len(target_set) >= len(current_set):
+            return False
+        if not set(natural_active_ranks) & target_set:
+            return False
+        if dp_world_size != len(current_active):
+            return False
+        return True
+
     def restore_elastic_parallel_groups_if_needed(self) -> None:
