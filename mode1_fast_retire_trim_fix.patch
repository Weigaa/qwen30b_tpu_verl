+    def _maybe_async_destroy_fast_retired_mc2_device_pgs(self, deferred) -> None:
+        """Bound HCCL resources kept by full-restore MC2 fast retire."""
+        if not _env_flag(
+                "VLLM_ASCEND_MODE1_PARITY_ASYNC_DESTROY_FAST_RETIRED_MC2", "1"):
+            return
+        try:
+            keep_limit = int(os.getenv(
+                "VLLM_ASCEND_MODE1_PARITY_MAX_FAST_RETIRED_MC2_DEVICE_PGS", "1") or "1")
+        except ValueError:
+            keep_limit = 1
+        keep_limit = max(0, keep_limit)
+        candidates = [
+            item for item in deferred
+            if item.get("group_kind") == "mc2"
+            and item.get("reason") == "mode1_full_restore"
+            and item.get("device_pgs")
+        ]
+        overflow = len(candidates) - keep_limit
+        if overflow <= 0:
+            return
+        to_destroy = []
+        for item in candidates[:overflow]:
+            device_pgs = item.get("device_pgs") or []
+            if device_pgs:
+                to_destroy.extend(device_pgs)
+                item["device_pgs"] = []
+        if not to_destroy:
+            return
+
+        def _destroy(rank: int, pgs: list[object]) -> None:
+            start_t = time.perf_counter()
+            destroyed = 0
+            for pg in pgs:
+                try:
+                    torch.distributed.destroy_process_group(pg)
+                    destroyed += 1
+                except Exception:
+                    logger.exception(
+                        "Elastic async fast-retired MC2 device PG destroy failed: rank=%s",
+                        rank)
+            logger.info(
+                "Elastic async fast-retired MC2 device PG destroy done: rank=%s destroyed=%s elapsed_ms=%.2f",
+                rank, destroyed, (time.perf_counter() - start_t) * 1000.0)
+
+        logger.info(
+            "Elastic async fast-retired MC2 device PG destroy queued: rank=%s queued=%s keep_limit=%s deferred_count=%s",
+            self.rank, len(to_destroy), keep_limit, len(deferred))
+        thread = threading.Thread(
+            target=_destroy, args=(self.rank, to_destroy), daemon=True)
+        thread.start()
+        threads = getattr(self, "_elastic_async_destroy_threads", None)
+        if threads is None:
+            threads = []
+            self._elastic_async_destroy_threads = threads
+        threads.append(thread)
+        self._elastic_async_destroy_threads = [t for t in threads if t.is_alive()]
+
